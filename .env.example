# Multi-Cloud API Rewriter Key Configuration
# Copy this file to .env and add your private API keys.
# The pipeline tries keys in order of priority:
# 1st OpenRouter -> 2nd Gemini -> 3rd Cerebras -> 4th Groq

# 1. OpenRouter (Priority 1)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 2. Google Gemini (Priority 2)
GEMINI_API_KEY=your_google_gemini_api_key_here

# 3. Cerebras (Priority 3)
CEREBRAS_API_KEY=your_cerebras_api_key_here

# 4. Groq (Priority 4)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Top-Priority Custom API Key (Priority 0)
# CUSTOM_API_KEY=your_custom_key_here
# CUSTOM_API_URL=https://api.openai.com/v1
# CUSTOM_API_MODEL=gpt-4o-mini
